// main-init.js
// Orchestration and initialization

function initOverlayLifecycle() {
  console.log("Initializing Great Sage Overlay...");

  // 1. Initial Setup
  const wrap = document.getElementById('wrap');
  if (wrap) {
    wrap.classList.add('window-visible');
  }

  // Boot SFX
  const sfxStartup = new Audio('../assets/sfx/Startup.wav');
  sfxStartup.play().catch(() => {});

  setTimeout(() => {
    const sfxAppear = new Audio('../assets/sfx/Overlay_apear.wav');
    sfxAppear.play().catch(() => {});
  }, 500);

  // 2. Boot Sequence
  bootStartTime = performance.now();

  // 3. Start Render Loop
  startRenderLoop();

  // 4. Initial Mode
  window.setMode('standby');

  // 5. Greeting Sequence
  // Wait for boot animations to settle, then say hello
  setTimeout(() => {
    window.setMode('speaking');
    window.setCaption("Greetings. I am the Great Sage. I am now listening for your command.");

    // Signal the backend to start listening immediately
    if (window.chrome && window.chrome.webview) {
      window.chrome.webview.postMessage("START_LISTENING_NOW");
    }

    // Transition to listening mode after the greeting text is read
    setTimeout(() => {
      window.setMode('listening');
    }, 3500);

    // Return to standby after a while if no one speaks
    setTimeout(() => {
      if (window.currentMode === 'listening') {
        window.setMode('standby');
        setTimeout(() => {
          window.setCaption("");
        }, 3000);
      }
    }, 8000);
  }, 2000);

  console.log("Overlay lifecycle started.");
}

// Execute on load
window.addEventListener('DOMContentLoaded', () => {
  initOverlayLifecycle();
});
